---
import '../styles/fonts.css';
import '../styles/site.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Absolute path to a social-share image, e.g. "/images/foo.jpg". */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'nZEBRA — an Erasmus+ project delivering an intensive blended course on climate-neutral buildings.',
  ogImage = '/images/webclip.png',
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site).href;
const ogImageAbs = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="nZEBRA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/webclip.png" />
  </head>
  <body>
    <slot />
    <Footer />

    <script>
      // Accessible mobile navigation toggle (replaces webflow.js).
      const nav = document.getElementById('primary-nav');
      const btn = document.querySelector('.menu-button-2');
      if (nav && btn) {
        const isOpen = () => btn.getAttribute('aria-expanded') === 'true';
        const open = () => {
          nav.setAttribute('data-nav-menu-open', '');
          btn.classList.add('w--open');
          btn.setAttribute('aria-expanded', 'true');
          btn.setAttribute('aria-label', 'Close menu');
        };
        const close = () => {
          nav.removeAttribute('data-nav-menu-open');
          btn.classList.remove('w--open');
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-label', 'Open menu');
        };
        btn.addEventListener('click', () => (isOpen() ? close() : open()));
        nav.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && isOpen()) {
            close();
            (btn as HTMLElement).focus();
          }
        });
        document.addEventListener('click', (e) => {
          const t = e.target as Node;
          if (isOpen() && !nav.contains(t) && !btn.contains(t)) close();
        });
      }

      // Subtle scroll-in reveal. Elements start visible; we only animate those
      // below the fold, and never when the user prefers reduced motion.
      const reveals = document.querySelectorAll<HTMLElement>('.reveal');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reveals.length && !reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add('is-visible');
                obs.unobserve(en.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        reveals.forEach((el) => {
          if (el.getBoundingClientRect().top > window.innerHeight) {
            el.classList.add('reveal--armed');
            io.observe(el);
          }
        });
      }
    </script>
  </body>
</html>
