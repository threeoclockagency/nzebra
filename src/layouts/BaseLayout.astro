---
import '../styles/fonts.css';
import '../styles/site.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  /** Page-specific title; the document title becomes "<title> | nZEBRA". */
  title: string;
  /** Overrides the composed document title verbatim (used by the home page). */
  fullTitle?: string;
  description?: string;
  /** Absolute path to a social-share image, e.g. "/images/foo.jpg". */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  fullTitle,
  description = 'nZEBRA — an Erasmus+ project delivering an intensive blended course on climate-neutral buildings.',
  ogImage = '/images/og-default.png',
  ogType = 'website',
} = Astro.props;

const docTitle = fullTitle ?? `${title} | nZEBRA`;
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site).href;
const ogImageAbs = new URL(ogImage, Astro.site).href;

// Matomo Cloud (cookieless) — only emitted when both values are configured via
// build-time public env vars. These are not secrets; set them in Vercel.
const matomoHost = import.meta.env.PUBLIC_MATOMO_HOST;
const matomoSiteId = import.meta.env.PUBLIC_MATOMO_SITE_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Preload the fonts used above the fold so there is no visible swap. -->
    <link rel="preload" href="/fonts/dm-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/dm-serif-text-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{docTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="nZEBRA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/webclip.png" />
  </head>
  <body>
    <slot />
    <Footer />

    <!-- Interactions and analytics are external files so the CSP needs no
         'unsafe-inline' for scripts. -->
    <script src="/js/ui.js" defer is:inline></script>
    {
      matomoHost && matomoSiteId && (
        <script
          src="/js/matomo.js"
          data-host={matomoHost}
          data-site-id={matomoSiteId}
          defer
          is:inline
        />
      )
    }
  </body>
</html>
