---
// Shared site footer. Reproduces the Webflow footer markup. Changes from the
// original: the EU funding notice typo "not" -> "nor" is corrected, social
// icons are served from our own hosting, the dead "#" YouTube icon is dropped,
// and the Brevo newsletter block is not included anywhere.
---

<div class="footer">
  <div class="wrap">
    <div class="div-block-59">
      <div class="footer-wrapper-three-2">
        <div class="footer-block-three-2">
          <a href="/about-us" class="footer-link-three-2">About us</a>
          <a href="/nzebra-course" class="footer-link-three-2">nZEBRA course</a>
          <a href="/resources" class="footer-link-three-2">Resources</a>
          <a href="/news-events" class="footer-link-three-2">News &amp; Events</a>
          <a href="/contact" class="footer-link-three-2">Contact</a>
        </div>
        <div class="footer-social-block-three-2">
          <a
            href="https://www.linkedin.com/company/nzebra/"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-link-three-2 w-inline-block"
            aria-label="nZEBRA on LinkedIn"
          >
            <img src="/images/linkedin_1384046.svg" width="24" alt="" />
          </a>
          <a
            href="https://twitter.com/nZEBRAproject"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-link-three-2 w-inline-block"
            aria-label="nZEBRA on X (Twitter)"
          >
            <img src="/images/social-x.svg" width="24" alt="" />
          </a>
        </div>
      </div>
      <div class="footer-divider-two-2"></div>
      <div class="footer-bottom-2">
        <div class="div-block-60">
          <img
            src="/images/EN_co_fundedvertical_RGB_BLACK-OUTLINE.png"
            width="50"
            sizes="50px"
            alt="Co-funded by the European Union"
            srcset="/images/EN_co_fundedvertical_RGB_BLACK-OUTLINE-p-500.png 500w, /images/EN_co_fundedvertical_RGB_BLACK-OUTLINE.png 899w"
          />
          <div class="footer-copyright-2">
            Co-funded by the European Union. Views and opinions expressed are however those of
            the author(s) and do not necessarily reflect those of the European Union or the
            Swedish National Agency. Neither the European Union nor the granting authority can
            be held responsible for them.
          </div>
        </div>
        <div class="footer-legal-block-2">
          <a href="/privacy-policy" class="footer-legal-link-2">Privacy Policy</a>
        </div>
      </div>
    </div>
  </div>
</div>
