---
// Shared site header / navigation. Reproduces the Webflow navbar markup
// (classes preserved for styling) but without webflow.js: the mobile menu is
// driven by our own accessible script in BaseLayout, which toggles the
// `data-nav-menu-open` attribute that webflow.css already styles.
interface Props {
  /** "dark" = white links over a dark hero (home, about, resources, modules);
   *  "light" = dark links over a light header (course, contact, news, privacy). */
  variant?: 'dark' | 'light';
}
const { variant = 'dark' } = Astro.props;
const light = variant === 'light';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
  { href: '/about-us', label: 'About' },
  { href: '/nzebra-course', label: 'nZEBRA course' },
  { href: '/resources', label: 'Resources' },
  { href: '/news-events', label: 'News & Events' },
  { href: '/contact', label: 'Contact' },
];
const logo = '/images/nzebra-logo_logoH-colour-light';
const homeCurrent = path === '/';
const lineSuffix = light ? '-light' : '';
const navbarBg = light ? 'navbar-light-bg' : 'navbar-dark-bg';
---

<div class={navbarBg}>
  <div role="banner" class="navbar-no-shadow-container-2 w-nav" data-collapse="medium">
    <div class="container-regular-2">
      <div class="navbar-wrapper-2">
        <a
          href="/"
          class:list={['navbar-brand-2', 'w-nav-brand', { 'w--current': homeCurrent }]}
          aria-label="nZEBRA — home"
          aria-current={homeCurrent ? 'page' : undefined}
        >
          <img
            src={`${logo}.png`}
            width="145"
            sizes="145px"
            alt="nZEBRA"
            srcset={`${logo}-p-500.png 500w, ${logo}-p-800.png 800w, ${logo}-p-1080.png 1080w, ${logo}.png 2994w`}
          />
        </a>

        <nav id="primary-nav" class="nav-menu-wrapper-2 w-nav-menu" aria-label="Main navigation">
          <ul role="list" class="nav-menu-2 w-list-unstyled">
            {
              links.map((l) => {
                const current = path === l.href;
                return (
                  <li class="nav-item">
                    <a
                      href={l.href}
                      class:list={['nav-link-2', 'text-small-bold', { 'cc-white': !light, 'w--current': current }]}
                      aria-current={current ? 'page' : undefined}
                    >
                      {l.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>

        <button
          type="button"
          class="menu-button-2 w-nav-button"
          aria-controls="primary-nav"
          aria-expanded="false"
          aria-label="Open menu"
        >
          <span class={`nav-topline${lineSuffix}`} aria-hidden="true"></span>
          <span class={`nav-middleline${lineSuffix}`} aria-hidden="true"></span>
          <span class={`nav-bottomline${lineSuffix}`} aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>
</div>
