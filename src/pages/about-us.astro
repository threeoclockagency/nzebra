---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="About us" description="Meet the nZEBRA consortium and see how the project built a blended course training professionals to design climate-neutral buildings.">
<div class="about-wrap">
    <div class="wrap">
      <Header variant="dark" />
      <header class="uui-section_header10">
        <div class="uui-page-padding-3">
          <div class="uui-container-small">
            <div class="uui-padding-vertical-xhuge-5">
              <div class="uui-text-align-center-2">
                <h1 class="h1 cc-white cc-large">About nZEBRA</h1>
                <div class="uui-space-small-3"></div>
                <div class="text-regular cc-white">Learn more about the project and the people behind it.</div>
              </div>
            </div>
          </div>
        </div>
      </header>
    </div>
  </div>
  <div class="about-section">
    <div class="wrap">
      <div class="div-block-5">
        <div id="w-node-d8548942-735f-19c0-a932-543cead85165-b347cead" class="title-max-width">
          <h2 class="about-title">We enhance nZEB skills for sustainable building design and climate action.</h2>
        </div>
        <div class="w-layout-grid our-mission text-small">
          <div id="w-node-d6474be7-ecc9-2dae-bbf5-0cee3688a450-b347cead" class="our-mission-wrap">
            <h4 class="h4">Our mission</h4>
            <div class="uui-space-xsmall"></div>
            <div class="text-small">Our project developed a robust, blended course on climate-neutral buildings, based on micro-credentials. <br>‍<br>This comprehensive programme covers various topics, including nZEB (nearly Zero Energy Buildings), climate change, environmental and social governance strategies. Through our interdisciplinary approach, we equipped both current and aspiring professionals with the skills needed to implement sustainable building solutions in alignment with global and EU standards.<br>‍</div>
            <div class="uui-space-medium"></div>
          </div>
          <div class="our-mission-wrap-image"><img src="/images/image-1.png" loading="lazy" width="728.5" sizes="(max-width: 767px) 100vw, 728.5px" alt srcset="/images/image-1-p-500.png 500w, /images/image-1-p-800.png 800w, /images/image-1-p-1080.png 1080w, /images/image-1.png 1457w" class="image-7"></div>
        </div>
        <div class="w-layout-grid eu-goals text-small">
          <div class="uui-layout01_image-wrapper"><img class="image-8" src="/images/Chart-2.png" width="400" height="Auto" alt sizes="(max-width: 479px) 100vw, 400px" loading="lazy" srcset="/images/Chart-2-p-500.png 500w, /images/Chart-2.png 503w">
            <h3 class="h3 cc-large">33%</h3>
            <div class="did-you-know">
              <h6 class="h4">Did you know that...?</h6>
              <div class="text-small">In the EU, construction and demolition waste make up more than 33% of all waste produced. Only one third of this construction waste is suitable for reuse.</div>
            </div>
          </div>
          <div id="w-node-c061eabd-44c1-2932-f0d5-aa90d170cd4b-b347cead" class="eu-goals-wrap">
            <h4 class="h4">The European goals in energy construction sector</h4>
            <div class="uui-space-xsmall"></div>
            <div class="text-small">Buildings are the single largest energy consumer in Europe, and represent over 1/3 of the EU’s energy-related greenhouse gas emissions.<br>‍<br>According to the European Energy Performance of Buildings Directive, since 2021, all new buildings must be nearly zero-energy buildings (NZEB), as part of Europe&#x27;s ambition for the decarbonisation of the built environment by 2050.</div>
            <div class="uui-space-medium"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="our-solution-section">
    <div class="wrap">
      <section class="uui-section_layout32">
        <div class="uui-page-padding-4">
          <div class="uui-container-large-4">
            <div class="uui-padding-vertical-xhuge-7">
              <div class="w-layout-grid uui-layout32_component">
                <div class="uui-layout32_content-left">
                  <h2 class="heading-14">Our solution</h2>
                  <div class="uui-space-medium-3"></div>
                  <div class="text-small">The nZEBRA project developed an intensive blended course in climate-neutral buildings, based on micro-credentials. The activities carried out to reach the project&#x27;s main objective included:</div>
                </div>
                <div class="uui-layout32_content-right">
                  <div class="uui-layout32_timeline-wrapper">
                    <div class="uui-layout32_progress-bar-wrapper">
                      <div class="uui-layout32_progress-bar"></div>
                    </div>
                    <div class="w-layout-grid uui-layout32_timeline-step">
                      <div id="w-node-_4d58f270-bf38-c8d2-fc6e-3d6b37fbaa48-b347cead" class="uui-layout32_timeline-left">
                        <div class="uui-layout32_timeline-icon-wrapper">
                          <div class="uui-icon-featured-outline-large"><img src="/images/customize-computer_14644615.svg" loading="lazy" width="24" alt></div>
                        </div>
                      </div>
                      <div class="uui-layout32_timeline-right">
                        <div class="uui-layout32_text-wrapper">
                          <h6 class="h6"><strong>Curriculum Design for Climate-Neutral Buildings Education</strong></h6>
                          <div class="uui-space-xxsmall-2"></div>
                          <div class="text-small">Crafting a curriculum that promotes interdisciplinary, hands-on learning through cutting-edge digital methods and practical assessments in the realm of climate-neutral buildings.</div>
                        </div>
                      </div>
                    </div>
                    <div class="w-layout-grid uui-layout32_timeline-step">
                      <div class="uui-layout32_timeline-left">
                        <div class="uui-layout32_timeline-icon-wrapper">
                          <div class="uui-icon-featured-outline-large"><img src="/images/graduate_2194231.svg" loading="lazy" width="32" height="Auto" alt></div>
                        </div>
                      </div>
                      <div class="uui-layout32_timeline-right">
                        <div class="uui-layout32_text-wrapper">
                          <h6 class="h6"><strong>Educational Content for Sustainable Construction</strong></h6>
                          <div class="uui-space-xxsmall-2"></div>
                          <div class="text-small">Developing interdisciplinary educational content that spans the entire life cycle of sustainable construction, with a focus on climate-neutral buildings.</div>
                        </div>
                      </div>
                    </div>
                    <div class="w-layout-grid uui-layout32_timeline-step">
                      <div class="uui-layout32_timeline-left">
                        <div class="uui-layout32_timeline-icon-wrapper">
                          <div class="uui-icon-featured-outline-large"><img src="/images/tools_1077198.svg" loading="lazy" width="24" alt></div>
                        </div>
                      </div>
                      <div class="uui-layout32_timeline-right">
                        <div class="uui-layout32_text-wrapper">
                          <h6 class="h6"><strong>Tools for Challenge-Based Learning in Sustainable Building</strong></h6>
                          <div class="uui-space-xxsmall-2"></div>
                          <div class="text-small">Creating guidance and practical tools to facilitate challenge-based learning scenarios in the project, accompanied by a toolkit for training instructors in utilising BIM and BEM software for sustainable building solutions.</div>
                        </div>
                      </div>
                    </div>
                    <div class="w-layout-grid uui-layout32_timeline-step">
                      <div class="uui-layout32_timeline-left">
                        <div class="uui-layout32_timeline-icon-wrapper">
                          <div class="uui-icon-featured-outline-large"><img src="/images/successful_7037650.svg" loading="lazy" width="24" alt></div>
                        </div>
                      </div>
                      <div class="uui-layout32_timeline-right">
                        <div class="uui-layout32_text-wrapper">
                          <h6 class="h6"><strong>Evaluation of the Climate-Neutral Buildings Blended Course</strong></h6>
                          <div class="uui-space-xxsmall-2"></div>
                          <div class="text-small">Implementing and assessing the effectiveness of the Climate-Neutral Buildings blended course in providing interdisciplinary, practical training that aligns with current educational demands and market needs in building performance.</div>
                        </div>
                      </div>
                    </div>
                    <div class="w-layout-grid uui-layout32_timeline-step">
                      <div class="uui-layout32_timeline-left">
                        <div class="uui-layout32_timeline-icon-wrapper">
                          <div class="uui-icon-featured-outline-large"><img src="/images/object-exclude_9083675.svg" loading="lazy" alt height="24"></div>
                        </div>
                      </div>
                      <div class="uui-layout32_timeline-right">
                        <div class="uui-layout32_text-wrapper">
                          <h6 class="h6"><strong>Strategic Integration in Higher Education Programmes</strong></h6>
                          <div class="uui-space-xxsmall-2"></div>
                          <div class="text-small">Developing a strategy for the consistent delivery and integration of the project course within partner institutions and other Higher Education Institutes (HEIs), aiming for formal inclusion in master programmes and seeking international accreditation.</div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
  <div class="partners-section">
    <div class="wrap">
      <div class="uui-text-align-center-2">
        <div class="uui-max-width-large-3 align-center">
          <h2 class="heading-15">Our partners</h2>
          <div class="uui-space-xsmall-2"></div>
        </div>
      </div>
      <section class="uui-section_logos03">
        <div class="uui-page-padding-4">
          <div class="uui-container-large-4">
            <div class="uui-logos03_logo-list">
              <a id="w-node-_131505d1-1231-615a-c277-06a08d100dac-b347cead" href="https://uni-freiburg.de/" target="_blank" class="w-inline-block" rel="noopener noreferrer">
                <div id="w-node-_6082c941-3c34-0eb9-4420-f161d3cda885-b347cead" class="uui-logos03_wrapper"><img src="/images/csm_freiburg_638616fc2f.jpg" loading="lazy" alt="Company logo" class="uui-logos03_logo"></div>
              </a>
              <a id="w-node-ffd2c7c6-0b50-7d49-05e9-1359e6c87f6c-b347cead" href="https://www.tuhh.de/tuhh/startseite" target="_blank" class="w-inline-block" rel="noopener noreferrer">
                <div id="w-node-_6082c941-3c34-0eb9-4420-f161d3cda88d-b347cead" class="uui-logos03_wrapper-copy"><img src="/images/2_1.jpg" loading="lazy" alt="Company logo" class="uui-logos03_logo"></div>
              </a>
              <a id="w-node-_6dbf0ebb-6734-9332-a900-b28ee477abb5-b347cead" href="https://www.hh.se" target="_blank" class="w-inline-block" rel="noopener noreferrer">
                <div class="uui-logos03_wrapper"><img src="/images/hh-logo.svg" loading="lazy" alt="Company logo" class="uui-logos03_logo"></div>
              </a>
              <a id="w-node-b35aba20-a6a4-7f9e-bd19-a8ee258da1e9-b347cead" href="https://threeoclock.co" target="_blank" class="w-inline-block" rel="noopener noreferrer">
                <div id="w-node-ec9e7b49-2bb6-8f4c-7827-353ba016fb1f-b347cead" class="uui-logos03_wrapper"><img src="/images/5.jpg" loading="lazy" alt="Company logo" class="uui-logos03_logo"></div>
              </a>
              <a id="w-node-_1a165e39-db06-d9df-9484-73e981f6c283-b347cead" href="https://www.hep.hr/esco/" target="_blank" class="w-inline-block" rel="noopener noreferrer">
                <div class="uui-logos03_wrapper"><img src="/images/HEP_esco.svg" loading="lazy" width="421" alt="Company logo" class="uui-logos03_logo"></div>
              </a>
              <a id="w-node-_74b7b4ec-13ab-7458-9916-e5c7c770308f-b347cead" href="https://www.lunduniversity.lu.se" target="_blank" class="w-inline-block" rel="noopener noreferrer">
                <div class="uui-logos03_wrapper"><img src="/images/Lund_university_L_CMYK.svg" loading="lazy" width="265" alt="Company logo" class="uui-logos03_logo"></div>
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
