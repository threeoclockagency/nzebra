---
// Hand-authored (not generated by scripts/port-pages.mjs): the original page
// only offered a Brevo form, which we removed. Per the brief we show the two
// contacts with their role and institution (linked) plus the project LinkedIn,
// and no email address.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout
  title="Contact — nZEBRA"
  description="Contact the nZEBRA project consortium: project coordination at Halmstad University and communication by Three o’clock."
>
  <div class="news-wrap">
    <div class="wrap">
      <Header variant="light" />
      <section class="uui-section_contact03">
        <div class="uui-page-padding-7">
          <div class="uui-container-large-4">
            <div class="uui-padding-vertical-xhuge-8">
              <div class="uui-contact03_content">
                <h1 class="heading-17">Contact us</h1>
                <div class="uui-space-xsmall-3"></div>
                <div class="text-regular">We would love to hear from you.</div>
                <div class="uui-contact03_contact-list">
                  <div class="div-block-58">
                    <div class="text-regular">
                      <strong>Project coordinator<br /></strong>
                      Heidi Norrström |
                      <a
                        href="https://www.hh.se"
                        target="_blank"
                        rel="noopener noreferrer">Halmstad University</a>
                    </div>
                    <div class="text-regular">
                      <strong>Communication<br /></strong>
                      Evdokia Bairampa |
                      <a
                        href="https://threeoclock.co"
                        target="_blank"
                        rel="noopener noreferrer">Three o’clock</a>
                    </div>
                    <div class="text-regular"><br />Follow us!</div>
                    <div class="footer-social-block-three-2">
                      <a
                        href="https://www.linkedin.com/company/nzebra/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="footer-social-link-three-2 w-inline-block"
                        aria-label="nZEBRA on LinkedIn"
                      >
                        <img src="/images/linkedin_1384046.svg" width="24" alt="" />
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
