---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Contact — nZEBRA" description="Get in touch with the nZEBRA project consortium.">
<div class="news-wrap">
    <div class="wrap">
      <Header variant="light" />
      <header class="uui-section_header10">
        <div class="uui-page-padding-3">
          <div class="uui-container-small"></div>
        </div>
      </header>
      <section class="uui-section_contact03">
        <div class="uui-page-padding-7">
          <div class="uui-container-large-4">
            <div class="uui-padding-vertical-xhuge-8">
              <div class="w-layout-grid uui-contact03_component">
                <div class="uui-contact03_content">
                  <h1 class="heading-17">Contact us</h1>
                  <div class="uui-space-xsmall-3"></div>
                  <div class="text-regular">We would love to hear from you.</div>
                  <div class="uui-contact03_contact-list">
                    <div id="w-node-_2aa7cb36-4a23-c9d5-9d6a-c48755a67573-a2968324" class="div-block-58">
                      <div class="text-regular"><strong>Project coordinator<br></strong>Heidi Norrström | Halmstad University</div>
                      <div class="text-regular"><strong>Communication<br></strong>Evdokia Bairampa | Three o&#x27;clock </div>
                      <div class="text-regular"><br><br>Follow us!</div>
                      <div class="footer-social-block-three-2">
                        <a href="#" class="footer-social-link-three-2 w-inline-block"><img src="/images/social-facebook.svg" loading="lazy" alt></a>
                        <a href="#" class="footer-social-link-three-2 w-inline-block"><img src="/images/social-x.svg" loading="lazy" alt></a>
                        <a href="#" class="footer-social-link-three-2 w-inline-block"><img src="/images/social-youtube.svg" loading="lazy" alt></a>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="uui-contact03_form-wrapper w-form">
                  
                  <div class="success-message-2 w-form-done">
                    <div class="success-text">Thank you! Your submission has been received!</div>
                  </div>
                  <div class="error-message-2 w-form-fail">
                    <div class="error-text">Oops! Something went wrong while submitting the form.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
