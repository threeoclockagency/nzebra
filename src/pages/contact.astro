---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const arrow = `M4.167 10h11.666m0 0L10 4.167M15.833 10 10 15.833`;

const partners = [
  { name: 'University of Freiburg', url: 'https://uni-freiburg.de/', img: '/images/csm_freiburg_638616fc2f.webp' },
  { name: 'Hamburg University of Technology', url: 'https://www.tuhh.de/tuhh/startseite', img: '/images/2_1.webp' },
  { name: 'Halmstad University', url: 'https://www.hh.se', img: '/images/hh-logo.svg' },
  { name: "Three o'clock", url: 'https://threeoclock.co', img: '/images/5.webp' },
  { name: 'HEP ESCO', url: 'https://www.hep.hr/esco/', img: '/images/HEP_esco.svg' },
  { name: 'Lund University', url: 'https://www.lunduniversity.lu.se', img: '/images/Lund_university_L_CMYK.svg' },
];
---

<BaseLayout
  title="Contact"
  description="Reach the nZEBRA team through Halmstad University and Three o'clock, or follow the project's updates on LinkedIn."
>
  <div class="about-wrap">
    <div class="wrap">
      <Header variant="dark" />
      <header class="uui-section_header10">
        <div class="uui-page-padding-3">
          <div class="uui-container-small">
            <div class="uui-padding-vertical-xhuge-5">
              <div class="uui-text-align-center-2">
                <h1 class="h1 cc-white cc-large">Contact us</h1>
                <div class="uui-space-small-3"></div>
                <p class="text-regular cc-white">
                  Get in touch with the project team through their institutions, or follow nZEBRA.
                </p>
              </div>
            </div>
          </div>
        </div>
      </header>
    </div>
  </div>

  <div class="resources-wrap">
    <div class="wrap">
      <div class="uui-page-padding-3">
        <div class="uui-container-large-6">
          <div class="uui-padding-vertical-xhuge-5">
            <div class="contact-cards">
              <div class="contact-card">
                <span class="contact-card__role">Project coordinator</span>
                <span class="contact-card__name">Heidi Norrström</span>
                <a
                  class="contact-card__link"
                  href="https://www.hh.se"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Halmstad University
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d={arrow} stroke="currentColor" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>

              <div class="contact-card">
                <span class="contact-card__role">Communication</span>
                <span class="contact-card__name">Evdokia Bairampa</span>
                <a
                  class="contact-card__link"
                  href="https://threeoclock.co"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Three o'clock
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d={arrow} stroke="currentColor" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>

              <div class="contact-card contact-card--follow">
                <span class="contact-card__role">Follow nZEBRA</span>
                <div class="contact-card__social">
                  <a
                    href="https://www.linkedin.com/company/nzebra/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="nZEBRA on LinkedIn"
                  >
                    <img src="/images/linkedin_1384046.svg" width="28" height="28" alt="" />
                  </a>
                  <a
                    href="https://twitter.com/nZEBRAproject"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="nZEBRA on X"
                  >
                    <img src="/images/social-x.svg" width="28" height="28" alt="" />
                  </a>
                </div>
              </div>
            </div>

            <div class="contact-partners">
              {
                partners.map((p) => (
                  <a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
                    <img class="uui-logos03_logo" src={p.img} alt={p.name} loading="lazy" />
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
