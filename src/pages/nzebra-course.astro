---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="nZEBRA course — nZEBRA" description="The nZEBRA intensive blended course on climate-neutral buildings, built on micro-credentials across six interdisciplinary modules.">
<div class="wrap">
    <Header variant="light" />
  </div>
  <div class="header-nzebra">
    <div class="wrap">
      <header class="uui-section_header01">
        <div class="uui-page-padding-8">
          <div class="uui-container-large-5">
            <div class="uui-padding-vertical-xhuge-9">
              <div class="uui-max-width-large-5">
                <h1 class="h1 cc-large">The nZEBRA course</h1>
                <div class="uui-space-small-5"></div>
                <div class="text-regular">The nZEBRA course is designed to empower learners in developing innovative solutions for implementing nZEB and ZEB concepts in the building environment. This intensive, blended course on climate-neutral buildings, built on micro-credentials, has the potential to be accredited as either an elective or mandatory component of Master&#x27;s programmes, offering specific ECTS credits.</div>
              </div>
            </div>
          </div>
        </div>
      </header>
    </div>
  </div>
  <div class="courses-wrap">
    <div class="wrap">
      <div class="discover-kc-sections">
        <div class="wrap-2">
          <div class="pan-kc-section">
            <div class="container-large">
              <div class="section-title">
                <div class="margin-bottom margin-huge">
                  <h2 class="heading-16">Micro-credentials courses</h2>
                  <div class="kc-grid-wrap">
                    <div id="w-node-c71500ca-83cf-dc4c-c610-46af2f2d9039-2e041f0c" class="kc-info-wrap cc-italy-kc-wrap">
                      <div class="div-block-30">
                        <h3 class="h3 cc-small">Climate resilience: Adapting buildings for climate change</h3>
                      </div>
                      <div class="mc-button">
                        <a href="course/climate-change-adaptation.html" class="uui-button-2 w-inline-block">
                          <div class="text-small">Learn more</div>
                        </a>
                      </div>
                    </div>
                    <div id="w-node-c71500ca-83cf-dc4c-c610-46af2f2d9042-2e041f0c" class="kc-info-wrap cc-lithuania-kc-wrap">
                      <div class="div-block-30">
                        <h3 class="h3 cc-small">Circular Economy: Resource efficient energy and materials for reduced carbon footprint</h3>
                      </div>
                      <div class="mc-button">
                        <a href="course/circular-economy.html" class="uui-button-2 w-inline-block">
                          <div class="text-small">Learn more</div>
                        </a>
                      </div>
                    </div>
                    <div id="w-node-c71500ca-83cf-dc4c-c610-46af2f2d904b-2e041f0c" class="kc-info-wrap cc-irish-kc-wrap">
                      <div class="div-block-30">
                        <h3 class="h3 cc-small">Energy buildings: Advance energy management and production</h3>
                      </div>
                      <div class="mc-button">
                        <a href="course/energy-production.html" class="uui-button-2 w-inline-block">
                          <div class="text-small">Learn more</div>
                        </a>
                      </div>
                    </div>
                    <div id="w-node-c71500ca-83cf-dc4c-c610-46af2f2d9054-2e041f0c" class="kc-info-wrap cc-slovakia-kc-wrap">
                      <div class="div-block-30">
                        <h3 class="h3 cc-small">Smart buildings: Modern technologies and systems integration</h3>
                      </div>
                      <div class="mc-button">
                        <a href="course/smart-buildings.html" class="uui-button-2 w-inline-block">
                          <div class="text-small">Learn more</div>
                        </a>
                      </div>
                    </div>
                    <div id="w-node-c71500ca-83cf-dc4c-c610-46af2f2d905d-2e041f0c" class="kc-info-wrap cc-greek-kc-wrap">
                      <div class="div-block-30">
                        <h3 class="h3 cc-small">Building and Energy: Indoor climate, heating, cooling and ventilation systems</h3>
                      </div>
                      <div class="mc-button">
                        <a href="course/environmental-social-and-governmence-strategies.html" class="uui-button-2 w-inline-block">
                          <div class="text-small">Learn more</div>
                        </a>
                      </div>
                    </div>
                    <div id="w-node-c71500ca-83cf-dc4c-c610-46af2f2d9066-2e041f0c" class="kc-info-wrap cc-portugal-kc-wrap">
                      <div class="div-block-30">
                        <h3 class="h3 cc-small">Green construction: Life cycle analysis of buildings</h3>
                      </div>
                      <div class="mc-button">
                        <a href="course/life-cycle-assessment-of-buildings.html" class="uui-button-2 w-inline-block">
                          <div class="text-small">Learn more</div>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
