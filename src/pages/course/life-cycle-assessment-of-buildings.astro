---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import TeachingMaterials from '../../components/TeachingMaterials.astro';
---

<BaseLayout title="Green construction: Life cycle assessment of buildings" description="Module 3 of the nZEBRA course: life cycle assessment for green construction, measuring the environmental impact of buildings and materials.">
<div class="mc3-wrap">
    <div class="wrap">
      <Header variant="dark" />
      <header class="uui-section_header10">
        <div class="uui-page-padding-3">
          <div class="uui-container-small">
            <div class="uui-padding-vertical-xhuge-5">
              <div class="uui-text-align-center-2">
                <h1 class="h1 cc-white cc-large">Green construction: Life cycle assessment of buildings</h1>
                <div class="uui-space-small-3"></div>
              </div>
            </div>
          </div>
        </div>
      </header>
    </div>
  </div>
  <header class="uui-section_blogpost04-2">
    <div class="uui-page-padding-10">
      <div class="wrap">
        <div class="uui-container-large-7"></div>
      </div>
      <div class="wrap">
        <div class="mc-wrapper-3">
          <div class="uui-blogpost04_content-2">
            <h3 class="h3">Overview</h3>
            <div class="text-small">The module &quot;Green construction: LCA of buildings&quot; aims to provide masters students in architecture, civil and energy engineering and related fields with the knowledge and skills to conduct Life Cycle Assessments (LCA) of buildings. The primary objective is to promote an in-depth understanding of the environmental impacts associated with building materials in different construction processes. Students will learn how to assess building materials in construction process for sustainability and whether they meet carbon neutral standards.</div>
            <h3 class="h3">Learning objectives</h3>
            <ul role="list" class="list">
              <li class="list-item-mc text-small">Gain knowledge of Life Cycle Assessment (LCA) methodologies specific to buildings.</li>
              <li class="list-item-mc text-small">Develop the ability to critically evaluate the environmental impacts of various construction materials.</li>
              <li class="list-item-mc text-small">Acquire skills to assess buildings with a focus on sustainability.</li>
              <li class="list-item-mc text-small">Enable graduates to contribute to the field of green construction.</li>
              <li class="list-item-mc text-small">Expand knowledge related to mitigating climate change through sustainable building practices.</li>
            </ul>
          </div>
          <div class="mc_newsletter-2">
            <div class="div-block-61">
              <div class="icon-featured-large-3"><img src="/images/target_10884019.svg" loading="lazy" width="28" alt></div>
              <h3 class="h3 cc-no-margin">Who is it for?</h3>
            </div>
            <div class="uui-space-small-7"></div>
            <ul role="list" class="list">
              <li class="list-item-mc text-small">Civil and Environmental Engineering students.</li>
              <li class="list-item-mc text-small">Graduate students for civil engineering, environmental science, and architecture.</li>
              <li class="list-item-mc text-small">Construction project managers.</li>
              <li class="list-item-mc text-small">Architects and designers.</li>
              <li class="list-item-mc text-small">Sustainability developers and managers.</li>
              <li class="list-item-mc text-small">Policymakers and regulators.</li>
              <li class="list-item-mc text-small">Researchers and academics.</li>
            </ul>
            <a class="tm-jump" href="#teaching-materials">Go to teaching materials ↓</a>
          </div>
        </div>
      </div>
    </div>
  </header>
  <TeachingMaterials moduleNumber={3} />
</BaseLayout>
