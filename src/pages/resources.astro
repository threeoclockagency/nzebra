---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { modules } from '../data/modules';
import { statSync } from 'node:fs';

// Project materials and course modules use the original 3-column image layout
// (no card border); deliverables stay as a list. Sizes are read at build time.
function size(file: string) {
  const bytes = statSync(`public/documents/${file}`).size;
  return bytes >= 1048576 ? `${(bytes / 1048576).toFixed(1)} MB` : `${Math.round(bytes / 1024)} KB`;
}
const dl = (file: string) => `Download · ${file.split('.').pop()!.toUpperCase()} ${size(file)}`;

const materials = [
  { title: 'Brand manual', file: 'nZEBRA-Brand-Manual-3.pdf', image: '/images/Screenshot-2024-02-23-at-13.03.07.webp' },
  { title: 'Leaflet', file: 'nZEBRA-LEAFLET-updated3.pdf', image: '/images/Screenshot-2024-02-23-at-16.12.30.webp' },
  { title: 'Poster', file: 'nZEBRA-POSTER-final.pdf', image: '/images/Poster-mockup.webp' },
];

// The six course-module PDFs are listed inside Deliverables (after D2.4),
// titled "Module N – <unified name>" using the single source in data/modules.
const moduleDocs = modules.map((m) => ({
  label: `Module ${m.number} – ${m.title}`,
  file: m.number === 1 ? 'WP3-Course-content-development-module-1-6.pdf' : `WP3-Course-content-development-module-${m.number}.pdf`,
}));

const deliverables = [
  { label: 'D2.1: Analytical report on target groups’ learning needs and preferences', file: 'WP2-Analytical-report-on-target-groups-learning-needs-and-preferences-nZEBRA-D2-1-v3.pdf' },
  { label: 'D2.2: Pedagogical approach and course syllabus', file: 'WP2-Pedagogical-approach-and-Course-Syllabus-nZEBRA-Deliverable-2-2-UFR.pdf' },
  { label: 'D2.3: nZEBRA assessment strategy', file: 'WP2-nZEBRA-Assessment-Strategy-Deliverable-2-3-LU.pdf' },
  { label: 'D2.4: Methodological framework', file: 'WP2-Methodological-framework-nZEBRA-2-4-v1.pdf' },
  ...moduleDocs,
  { label: 'Train-the-trainers (ToT) toolkit', file: 'WP4-Train-of-trainers-Module-1-to-6.pdf' },
  { label: 'Hamburg digital and summer school report', file: 'WP4-Final-report-of-Hamburg-digital-and-summer-nZEBRA-school.pdf' },
  { label: 'D5.1: Project communication kit', file: 'WP5-nZEBRA-D5-1-Project-communication-kit.pdf' },
  { label: 'D5.2: Implementation of the dissemination and exploitation plan', file: 'WP5-nZEBRA-D5-2-Implementation-of-dissemination.pdf' },
  { label: 'D5.3: Exit, replication and sustainability strategy', file: 'WP5-3-nZEBRA-Exit-replication-and-sustainability-strategy.pdf' },
];

const arrow = 'M4.6665 9.99984H16.3332M16.3332 9.99984L10.4998 4.1665M16.3332 9.99984L10.4998 15.8332';
---

<BaseLayout
  title="Resources"
  description="Download nZEBRA's deliverables, course materials, booklets and dissemination outputs on climate-neutral and nearly zero-energy buildings."
>
  <div class="resources-wrap-copy">
    <div class="wrap">
      <Header variant="dark" />
      <header class="uui-section_header10">
        <div class="uui-page-padding-3">
          <div class="uui-container-small">
            <div class="uui-padding-vertical-xhuge-5">
              <div class="uui-text-align-center-2">
                <h1 class="h1 cc-white cc-large">Resources</h1>
                <div class="uui-space-small-3"></div>
                <p class="text-regular cc-white">
                  Download the project's deliverables, course materials and dissemination outputs.
                </p>
              </div>
            </div>
          </div>
        </div>
      </header>
    </div>
  </div>

  <div class="resources-wrap">
    <div class="wrap">
      <div class="uui-page-padding-3">
        <div class="uui-container-large-6">
          <div class="resources-body">
            <section class="resource-group">
              <div class="section-title"><h2 class="heading-7">Project materials</h2></div>
              <div class="w-layout-grid uui-layout73_component">
                {
                  materials.map((m) => (
                    <a class="uui-layout73_item resource-item" href={`/documents/${m.file}`} download>
                      <img class="resource-item__img" src={m.image} alt="" loading="lazy" />
                      <h6 class="h6">{m.title}</h6>
                      <span class="uui-button-link-3">
                        {dl(m.file)}
                        <svg width="21" height="20" viewBox="0 0 21 20" fill="none" aria-hidden="true">
                          <path d={arrow} stroke="currentColor" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    </a>
                  ))
                }
              </div>
            </section>

            <section class="resource-group">
              <div class="section-title"><h2 class="heading-7">Deliverables</h2></div>
              <ul class="resource-list" role="list">
                {
                  deliverables.map((d) => (
                    <li>
                      <a class="resource-doc" href={`/documents/${d.file}`} target="_blank" rel="noopener noreferrer">
                        <span class="resource-doc__icon" aria-hidden="true">
                          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M10 2.5v10m0 0 4-4m-4 4-4-4M3.5 15.5h13" stroke="currentColor" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </span>
                        <span class="resource-doc__label">{d.label}</span>
                        <span class="resource-doc__meta">PDF · {size(d.file)}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </section>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
