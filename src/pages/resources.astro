---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { modules } from '../data/modules';
import { statSync } from 'node:fs';

// Hand-authored (not ported): the documents are grouped into Project materials,
// Course modules and Deliverables, each shown with a download icon, type and size.
const moduleDocs = modules.map((m) => ({
  label: `Module ${m.number} – ${m.title}`,
  file:
    m.number === 1
      ? 'WP3-Course-content-development-module-1-6.pdf'
      : `WP3-Course-content-development-module-${m.number}.pdf`,
}));

const groups = [
  {
    title: 'Project materials',
    docs: [
      { label: 'Brand manual', file: 'nZEBRA-Brand-Manual-3.pdf' },
      { label: 'Leaflet', file: 'nZEBRA-LEAFLET-updated3.pdf' },
      { label: 'Poster', file: 'nZEBRA-POSTER-final.pdf' },
    ],
  },
  { title: 'Course modules', docs: moduleDocs },
  {
    title: 'Deliverables',
    docs: [
      { label: 'D2.1: Analytical report on target groups’ learning needs and preferences', file: 'WP2-Analytical-report-on-target-groups-learning-needs-and-preferences-nZEBRA-D2-1-v3.pdf' },
      { label: 'D2.2: Pedagogical approach and course syllabus', file: 'WP2-Pedagogical-approach-and-Course-Syllabus-nZEBRA-Deliverable-2-2-UFR.pdf' },
      { label: 'D2.3: nZEBRA assessment strategy', file: 'WP2-nZEBRA-Assessment-Strategy-Deliverable-2-3-LU.pdf' },
      { label: 'D2.4: Methodological framework', file: 'WP2-Methodological-framework-nZEBRA-2-4-v1.pdf' },
      { label: 'Train-the-trainers (ToT) toolkit', file: 'WP4-Train-of-trainers-Module-1-to-6.pdf' },
      { label: 'Hamburg digital and summer school report', file: 'WP4-Final-report-of-Hamburg-digital-and-summer-nZEBRA-school.pdf' },
      { label: 'D5.1: Project communication kit', file: 'WP5-nZEBRA-D5-1-Project-communication-kit.pdf' },
      { label: 'D5.2: Implementation of the dissemination and exploitation plan', file: 'WP5-nZEBRA-D5-2-Implementation-of-dissemination.pdf' },
      { label: 'D5.3: Exit, replication and sustainability strategy', file: 'WP5-3-nZEBRA-Exit-replication-and-sustainability-strategy.pdf' },
    ],
  },
];

function meta(file: string) {
  const type = file.split('.').pop()!.toUpperCase();
  const bytes = statSync(`public/documents/${file}`).size;
  const size = bytes >= 1048576 ? `${(bytes / 1048576).toFixed(1)} MB` : `${Math.round(bytes / 1024)} KB`;
  return `${type} · ${size}`;
}
---

<BaseLayout
  title="Resources"
  description="Download nZEBRA's deliverables, course materials, booklets and dissemination outputs on climate-neutral and nearly zero-energy buildings."
>
  <div class="resources-wrap-copy">
    <div class="wrap">
      <Header variant="dark" />
      <header class="uui-section_header10">
        <div class="uui-page-padding-3">
          <div class="uui-container-small">
            <div class="uui-padding-vertical-xhuge-5">
              <div class="uui-text-align-center-2">
                <h1 class="h1 cc-white cc-large">Resources</h1>
                <div class="uui-space-small-3"></div>
                <p class="text-regular cc-white">
                  Download the project's deliverables, course materials and dissemination outputs.
                </p>
              </div>
            </div>
          </div>
        </div>
      </header>
    </div>
  </div>

  <div class="resources-wrap">
    <div class="wrap">
      <div class="uui-page-padding-3">
        <div class="uui-container-large-6">
          <div class="uui-padding-vertical-xhuge-5">
            {
              groups.map((group) => (
                <section class="resource-group">
                  <h2 class="heading-7">{group.title}</h2>
                  <ul class="resource-list" role="list">
                    {group.docs.map((doc) => (
                      <li>
                        <a
                          class="resource-doc"
                          href={`/documents/${doc.file}`}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <span class="resource-doc__icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                              <path
                                d="M10 2.5v10m0 0 4-4m-4 4-4-4M3.5 15.5h13"
                                stroke="currentColor"
                                stroke-width="1.67"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          </span>
                          <span class="resource-doc__label">{doc.label}</span>
                          <span class="resource-doc__meta">{meta(doc.file)}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
